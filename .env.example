# Required: create a strong random API key, e.g. python -c 'import secrets;print(secrets.token_urlsafe(32))'
APP_API_KEY=
# sqlite is for local demo only. Set PostgreSQL URL for multi-user or further hardening.
DATABASE_URL=sqlite:///./copilot.db
# Optional: local Ollama planner URL. Unset => deterministic, testable intent router.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
